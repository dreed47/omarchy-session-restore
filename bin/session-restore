#!/usr/bin/env node
// session-restore - save the current apps + window layout and restore them,
// on demand or on login. This CLI is the single restore engine: the bar
// widget shells out to it, and so does the post-boot hook (which runs with no
// shell around). Pure logic lives in ../restoreLogic.mjs; system calls in
// ../lib/io.mjs.

import { dirname, join, resolve } from "node:path"
import { fileURLToPath } from "node:url"

import {
    generateDefaultName,
    validProfilePath,
    procInfoScript,
    parseProcInfo,
    assembleWindows,
    tabCaptureInvocations,
    parseTabResults,
    buildSnapshot,
    buildRestoreScript,
    wrapRestoreRunner,
    bootMarkerPath,
    isFreshLogin,
    bootAppliedMarkerPath,
    bootMarkerMatches,
    shutdownHookMarkerPath,
    shellArg,
} from "../restoreLogic.mjs"

import {
    hyprctlJson,
    bash,
    bashExit,
    notify,
    hasCommand,
    run,
    compositorAgeSeconds,
    currentSessionId,
    ensureOwnedDir,
    readRegularBounded,
    atomicWriteFile,
    unlinkRegular,
    listProfileNames,
    loadProfile,
    saveProfile,
    deleteProfile,
    readSettings,
    writeSettings,
} from "../lib/io.mjs"

// How young the compositor must be for a `--boot` run to count as a login.
const BOOT_WINDOW = Number(process.env.SESSION_RESTORE_BOOT_WINDOW) || 120

const PLUGIN_DIR = resolve(dirname(fileURLToPath(import.meta.url)), "..")
const CAPTURE_SCRIPT = join(PLUGIN_DIR, "scripts", "capture_tabs.py")

const HOME = process.env.HOME || ""
const PROFILE_DIR = process.env.SESSION_RESTORE_DIR
    || join(HOME, ".config", "omarchy", "session-restore")

function die(msg, code = 1) {
    process.stderr.write(`session-restore: ${msg}\n`)
    process.exit(code)
}

function isMissing(e) {
    return e && (e.code === "ENOENT" || /no such file/i.test(e.message || ""))
}

// Off by default: browser tab capture/restore fights Chrome's own session
// restore in ways that are difficult for a user to reason about (see
// CHANGELOG 2.1.0). Off, a browser window is treated like any other app -
// moved into place if running, launched bare if not - and Chrome is left
// completely alone to do whatever it naturally does.
function browserTabRestoreEnabled() {
    try {
        return readSettings(PROFILE_DIR).browserTabRestore === true
    } catch {
        return false
    }
}

function readBootMarker() {
    try {
        return readRegularBounded(bootMarkerPath(PROFILE_DIR), 4096).toString("utf8").trim()
    } catch {
        return ""
    }
}

function resolveName(args, { forWrite }) {
    if (args.boot) {
        const name = readBootMarker()
        if (!name) return null
        return name
    }
    if (args.positionals.length > 0) return args.positionals[0]
    if (forWrite) return generateDefaultName()
    return null
}

function parseArgs(argv) {
    const out = { boot: false, json: false, clear: false, dryRun: false, positionals: [] }
    for (const a of argv) {
        if (a === "--boot") out.boot = true
        else if (a === "--json") out.json = true
        else if (a === "--clear") out.clear = true
        else if (a === "--dry-run") out.dryRun = true
        else if (a === "-h" || a === "--help") out.help = true
        else if (a.startsWith("--")) die(`unknown option: ${a}`)
        else out.positionals.push(a)
    }
    return out
}

// --- commands -------------------------------------------------------------

async function cmdSave(args) {
    const name = resolveName(args, { forWrite: true })
    if (args.boot && !name) {
        process.stdout.write("no boot profile set - nothing to save\n")
        return
    }
    if (validProfilePath(name, PROFILE_DIR) === null) die(`invalid profile name: ${name}`)

    if (browserTabRestoreEnabled() && !(await hasCommand("python3"))) {
        process.stderr.write("session-restore: python3 not found - browser tabs will not be captured\n")
    }

    const clients = await hyprctlJson("clients")
    const pids = [...new Set(clients.map((c) => c.pid))]
    const procInfo = parseProcInfo(await bash(procInfoScript(pids)))
    const monitors = await hyprctlJson("monitors")

    const windows = assembleWindows({ clients, monitors, procInfo, home: HOME })
    const invocations = browserTabRestoreEnabled() ? tabCaptureInvocations(windows, CAPTURE_SCRIPT) : []
    const tabResults = invocations.length > 0
        ? parseTabResults(await bash(invocations.join("; ")))
        : {}

    const snapshot = buildSnapshot({ clients, monitors, procInfo, tabResults, home: HOME })

    try {
        saveProfile(PROFILE_DIR, name, snapshot)
    } catch (e) {
        die(e.message)
    }
    process.stdout.write(`saved "${name}" (${snapshot.windows.length} windows)\n`)
}

// Login guards for `restore --boot`. Returns false (caller should stop) when
// this shell start is not a fresh login, or this login was already handled.
// `--dry-run` runs the checks but never consumes the once-per-session stamp.
async function passesBootGuards(args) {
    const age = await compositorAgeSeconds()
    if (!isFreshLogin(age, BOOT_WINDOW)) {
        process.stdout.write(`hyprland has been up ${age}s - not a login, nothing to do\n`)
        return false
    }

    const runtimeDir = process.env.XDG_RUNTIME_DIR
    if (!runtimeDir) {
        process.stderr.write("session-restore: no XDG_RUNTIME_DIR - proceeding on the compositor-age check alone\n")
        return true
    }

    const marker = bootAppliedMarkerPath(runtimeDir)
    const markerDir = dirname(marker)
    try {
        ensureOwnedDir(markerDir)
    } catch (e) {
        die(`cannot prepare ${markerDir}: ${e.message}`)
    }

    // The stamp holds this Hyprland session's signature. A matching stamp means
    // this login was already handled (e.g. a mid-session `omarchy restart
    // shell`); an empty or differently-signed stamp is stale - from a previous
    // Hyprland run whose $XDG_RUNTIME_DIR was not cleared - and is overwritten.
    const sid = await currentSessionId()
    let prior = ""
    try { prior = readRegularBounded(marker, 4096).toString("utf8") } catch { /* no stamp yet */ }

    if (sid && bootMarkerMatches(prior, sid)) {
        process.stdout.write("already restored this Hyprland session - nothing to do\n")
        return false
    }

    if (args.dryRun) return true

    try {
        atomicWriteFile(marker, (sid || "1") + "\n")
    } catch (e) {
        die(`cannot write ${marker}: ${e.message}`)
    }
    return true
}

async function cmdRestore(args) {
    const name = resolveName(args, { forWrite: false })
    if (!name) {
        if (args.boot) {
            process.stdout.write("no boot profile set - nothing to restore\n")
            return
        }
        die("restore: profile name required")
    }

    let profile
    try {
        profile = loadProfile(PROFILE_DIR, name)
    } catch (e) {
        if (isMissing(e)) {
            // For --boot this is a stale .boot-profile pointing at a deleted
            // profile - not worth dying over, and not worth burning the stamp.
            if (args.boot) {
                process.stdout.write(`boot profile "${name}" no longer exists - nothing to restore\n`)
                return
            }
            die(`no such profile: ${name}`)
        }
        die(e.message)
    }
    if (!profile.windows.length) {
        die(`profile is empty: ${name}`)
    }

    // Only now, with a real profile to restore, run the login guards (which
    // write the once-per-session stamp).
    if (args.boot && !(await passesBootGuards(args))) return

    // The toggle governs restore too, not just future saves - a profile
    // saved while tab restore was on (or before this setting existed) should
    // not surprise an "off" user by replaying old captured tabs.
    if (!browserTabRestoreEnabled()) {
        for (const w of profile.windows) w.tabs = []
    }

    let existing = []
    try {
        existing = await hyprctlJson("clients")
    } catch {
        existing = []
    }

    let liveMonitors = []
    try {
        liveMonitors = await hyprctlJson("monitors")
    } catch {
        liveMonitors = []
    }

    const { script, count } = buildRestoreScript(profile, existing, liveMonitors)

    if (args.dryRun) {
        process.stdout.write(script + "\n")
        process.stderr.write(`session-restore: dry run - ${count} windows would be moved/spawned\n`)
        return
    }

    const code = await bashExit(wrapRestoreRunner(script))

    if (code !== 0) {
        await notify("Restore failed", "Not all windows could be restored")
        die(`restore script exited ${code}`, code)
    }
    await notify("Session restored", `${count} windows`)
    process.stdout.write(`restored "${name}" (${count} windows)\n`)
}

function listProfiles() {
    try {
        return listProfileNames(PROFILE_DIR)
    } catch {
        return []
    }
}

function cmdList(args) {
    const names = listProfiles()
    if (args.json) {
        process.stdout.write(JSON.stringify(names) + "\n")
        return
    }
    const boot = readBootMarker()
    for (const n of names) process.stdout.write(`${n === boot ? "* " : "  "}${n}\n`)
}

// window count + save time for one profile, for the panel's row detail.
function profileMeta(name) {
    try {
        const p = loadProfile(PROFILE_DIR, name)
        return {
            name,
            windows: Array.isArray(p.windows) ? p.windows.length : 0,
            savedAt: typeof p.timestamp === "number" ? p.timestamp : null,
        }
    } catch {
        return { name, windows: 0, savedAt: null }
    }
}

// Everything the bar widget needs in one call: the profiles (with window
// counts and save times) plus which one, if any, is armed for login.
function cmdStatus(args) {
    const names = listProfiles()
    const boot = readBootMarker()
    const bootExists = boot !== "" && names.includes(boot)
    if (args.json) {
        process.stdout.write(JSON.stringify({
            profiles: names.map(profileMeta),
            boot,
            bootExists,
            browserTabRestore: browserTabRestoreEnabled(),
        }) + "\n")
        return
    }
    for (const n of names) {
        const m = profileMeta(n)
        process.stdout.write(`${n === boot ? "* " : "  "}${n}  (${m.windows} window${m.windows === 1 ? "" : "s"})\n`)
    }
    process.stdout.write(`\nlogin profile: ${boot || "(none)"}` +
        (boot && !bootExists ? " (missing!)" : "") + "\n")
}

function cmdDelete(args) {
    const name = args.positionals[0]
    if (!name) die("delete: profile name required")
    try {
        deleteProfile(PROFILE_DIR, name)
    } catch (e) {
        die(`could not delete ${name}: ${e.message}`)
    }
    if (readBootMarker() === name) {
        try { unlinkRegular(bootMarkerPath(PROFILE_DIR)) } catch { /* already gone */ }
    }
    process.stdout.write(`deleted "${name}"\n`)
}

function cmdTabRestore(args) {
    const value = args.positionals[0]
    if (!value) {
        process.stdout.write((browserTabRestoreEnabled() ? "on" : "off") + "\n")
        return
    }
    if (value !== "on" && value !== "off") die(`tab-restore: expected "on" or "off"`)
    try {
        const settings = readSettings(PROFILE_DIR)
        settings.browserTabRestore = (value === "on")
        writeSettings(PROFILE_DIR, settings)
    } catch (e) {
        die(e.message)
    }
    process.stdout.write(`browser tab restore: ${value}\n`)
}

function cmdBootProfile(args) {
    const marker = bootMarkerPath(PROFILE_DIR)
    if (args.clear) {
        try { unlinkRegular(marker) } catch (e) {
            if (!isMissing(e)) die(e.message)
        }
        process.stdout.write("boot profile cleared\n")
        return
    }
    const name = args.positionals[0]
    if (!name) {
        process.stdout.write(readBootMarker() + "\n")
        return
    }
    try {
        loadProfile(PROFILE_DIR, name)
    } catch (e) {
        if (isMissing(e) || /invalid profile name/.test(e.message)) die(`no such profile: ${name}`)
        die(e.message)
    }
    try {
        ensureOwnedDir(PROFILE_DIR)
        atomicWriteFile(marker, name + "\n")
    } catch (e) {
        die(e.message)
    }
    process.stdout.write(`boot profile set to "${name}"\n`)
}

// Register Hyprland exec-shutdown once per compositor instance so logout
// overwrites the pinned session. Mid-session shell restarts see a matching
// stamp and do not add a second hook.
async function cmdInstallShutdownHook() {
    const runtimeDir = process.env.XDG_RUNTIME_DIR
    const sid = await currentSessionId()
    if (runtimeDir && sid) {
        const stamp = shutdownHookMarkerPath(runtimeDir)
        try {
            const prior = readRegularBounded(stamp, 4096).toString("utf8")
            if (bootMarkerMatches(prior, sid)) {
                process.stdout.write("shutdown hook already installed this session\n")
                return
            }
        } catch { /* no stamp yet */ }
        try { ensureOwnedDir(dirname(stamp)) } catch (e) { die(e.message) }
    }

    const cli = resolve(fileURLToPath(import.meta.url))
    const hook = [process.execPath, cli, "save", "--boot"].map(shellArg).join(" ")
    const { code, stderr } = await run("hyprctl", ["keyword", "exec-shutdown", hook])
    if (code !== 0) die(`hyprctl keyword exec-shutdown failed: ${(stderr || "").trim()}`)
    if (runtimeDir && sid) {
        try { atomicWriteFile(shutdownHookMarkerPath(runtimeDir), sid + "\n") } catch (e) { die(e.message) }
    }
    process.stdout.write("installed hyprland exec-shutdown hook\n")
}

const HELP = `session-restore - save and restore your apps + window layout

Usage:
  session-restore save [name] [--boot]     capture the current layout
  session-restore restore [name] [--boot]  reopen a saved layout
  session-restore list [--json]            list saved profiles (* = login profile)
  session-restore status [--json]          profiles + which one restores at login
  session-restore delete <name>            remove a saved profile
  session-restore boot-profile [name|--clear]
                                           get/set the profile restored on login
  session-restore tab-restore [on|off]     get/set browser tab capture+restore (default: off)
  session-restore install-shutdown-hook    register logout save of the pinned session

Profiles live in ${PROFILE_DIR}
(override with SESSION_RESTORE_DIR).
`

async function main() {
    const [, , sub, ...rest] = process.argv
    if (!sub || sub === "help" || sub === "-h" || sub === "--help") {
        process.stdout.write(HELP)
        return
    }
    const args = parseArgs(rest)
    if (args.help) {
        process.stdout.write(HELP)
        return
    }
    switch (sub) {
        case "save": return cmdSave(args)
        case "restore": return cmdRestore(args)
        case "list": return cmdList(args)
        case "status": return cmdStatus(args)
        case "delete": case "rm": return cmdDelete(args)
        case "boot-profile": return cmdBootProfile(args)
        case "tab-restore": return cmdTabRestore(args)
        case "install-shutdown-hook": return cmdInstallShutdownHook()
        default: die(`unknown command: ${sub} (try --help)`)
    }
}

main().catch((e) => die(e.message))
